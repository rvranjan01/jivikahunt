# ==============================================================================
# JivikaHunt — Environment Variables Template
# Copy this file to .env.local for local development.
# Never commit real credentials or secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Full connection string for MongoDB Atlas database.
# Local development example: mongodb://127.0.0.1:27017/jivikahunt
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/jivikahunt?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 2. AUTHENTICATION & SECURITY (Jose JWT & Passwords)
# ------------------------------------------------------------------------------
# Secret key used by jose to sign and verify session JWTs in httpOnly cookies.
# Must be at least 32 characters long. Generate via: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_string_of_at_least_32_characters

# JWT token expiration window (e.g., '12h', '1d', '7d'). Default is short (12 hours).
JWT_EXPIRY=12h

# Salt used to hash reporter IP addresses for rate limiting and fraud deterrence.
HASH_SALT=replace_with_a_random_salt_for_ip_hashing

# Default Master TOTP secret for the initial admin account setup (Base32 encoded).
# Generated during first-time admin setup.
ADMIN_TOTP_SECRET=JBSWY3DPEHPK3PXP

# ------------------------------------------------------------------------------
# 3. EMAIL SERVICE (Resend)
# ------------------------------------------------------------------------------
# API key obtained from Resend (https://resend.com) used for sending contributor
# invites, password reset links, and subscriber double opt-in alerts.
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuvwxyz

# Verified sender email address configured in Resend.
RESEND_FROM_EMAIL=JivikaHunt <alerts@jivikahunt.com>

# ------------------------------------------------------------------------------
# 4. SOCIAL & AUTOMATION INTEGRATIONS
# ------------------------------------------------------------------------------
# Telegram Bot Token from @BotFather for auto-posting published jobs to the channel.
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Telegram Channel username (e.g. @jivikahunt) or numeric chat ID where posts are published.
TELEGRAM_CHANNEL_ID=@jivikahunt

# ------------------------------------------------------------------------------
# 5. PUBLIC SITE & MONETIZATION (Client-Side Safe)
# ------------------------------------------------------------------------------
# Canonical public base URL of the site (used for sitemaps, canonical tags, and Open Graph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google AdSense Publisher ID (e.g. ca-pub-1234567890123456).
# If left empty, all AdSense slots remain completely dormant.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# OneSignal App ID for Web Push Notifications (loaded only after cookie consent).
NEXT_PUBLIC_ONESIGNAL_APP_ID=

# Google Analytics 4 Measurement ID or analytics script identifier (loaded only after consent).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ------------------------------------------------------------------------------
# 6. OPERATIONAL TUNING
# ------------------------------------------------------------------------------
# Maximum number of jobs a contributor can publish per 24-hour day. Default: 30.
CONTRIBUTOR_DAILY_LIMIT=30
