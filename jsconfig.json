{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"]
    },
    "checkJs": true,
    "jsx": "preserve",
    "module": "esnext",
    "moduleResolution": "bundler",
    "target": "es2022",
    "allowJs": true,
    "strict": false
  },
  "include": ["next-env.d.ts", "**/*.js", "**/*.jsx", "**/*.mjs", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
